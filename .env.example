# ==============================================================================
# مقرأة الهدى الإلكترونية — إعدادات البيئة
# MAQRAAT AL-HUDA ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data Provider Mode: 'sqlite' (current local default) or 'supabase' (Phase 4B cloud production)
DATA_SOURCE=sqlite

# Administration Session Signing Secret (REQUIRED in production - min 32 chars random hex)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=replace-with-secure-64-char-random-hex-secret

# Optional: Force Secure Cookie flag (set to true in HTTPS production; auto-detected behind proxies)
# FORCE_SECURE_COOKIE=true

# Optional: Bootstrap first SQLite admin password ONLY on fresh empty DB
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-initial-password

# ==============================================================================
# SUPABASE PRODUCTION CREDENTIALS (Phase 4 Migration)
# ==============================================================================

# Public Supabase Project URL & Anon Key (safe for Next.js client/server)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY Service Role Key
# WARNING: NEVER prefix with NEXT_PUBLIC_ and NEVER expose in browser code!
# Used ONLY in server-side Route Handlers (e.g., private file upload to staff-documents bucket)
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-secret
